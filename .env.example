APP_ENV=development
# On Vercel/serverless use Supabase's *Session pooler* URL (IPv4), not the direct
# db.<ref>.supabase.co host, which is IPv6-only and unreachable from Vercel:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<random-64-hex-chars>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

BUSINESS_TIMEZONE=Asia/Kolkata

LEAD_PROPERTY_LOCK_DURATION_DAYS=3
WEEKLY_DAY_OFF_ALLOWANCE=1

# Browser origins allowed to call the API (comma-separated). Defaults to the
# employee.divinevisioninfra.com variants (http/https, with/without www).
# CORS_ALLOWED_ORIGINS=https://employee.divinevisioninfra.com,https://www.employee.divinevisioninfra.com

RATE_LIMIT_MAX_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60

# Required, at least 32 characters — the app will not start without it.
BACK_OFFICE_API_KEY=<random-64-hex-chars>

# --- Employee signup email (Resend) ---
# RESEND_API_KEY alone configures Resend's SMTP relay (smtp.resend.com:465).
# The sender must be on a domain verified in Resend.
RESEND_API_KEY=<re_...>
DIVINE_RESEND_EMAIL=noreply@divinevisioninfra.com
# EMAIL_DELIVERY_MODE=log   # local dev only: print emails to the server log instead of sending
# Only these domains can self-register (comma-separated; empty = anyone).
# SIGNUP_ALLOWED_EMAIL_DOMAINS=divinevisioninfra.com

# Lock expiry sweep. Long-running hosts: leave the in-process sweeper on.
# Vercel/serverless: set ENABLE_BACKGROUND_LOCK_SWEEPER=false and schedule
# cron-job.org to POST /api/v1/internal/sweep with header X-Cron-Secret.
ENABLE_BACKGROUND_LOCK_SWEEPER=true
# At least 32 characters. Leave unset to disable the sweep endpoint.
# CRON_SECRET=<random-64-hex-chars>
