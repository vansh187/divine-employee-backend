APP_ENV=development
# On Vercel/serverless use Supabase's *Session pooler* URL (IPv4), not the direct
# db.<ref>.supabase.co host, which is IPv6-only and unreachable from Vercel:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<random-64-hex-chars>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

BUSINESS_TIMEZONE=Asia/Kolkata

LEAD_PROPERTY_LOCK_DURATION_DAYS=3
WEEKLY_DAY_OFF_ALLOWANCE=1

RATE_LIMIT_MAX_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60

# Required, at least 32 characters — the app will not start without it.
BACK_OFFICE_API_KEY=<random-64-hex-chars>
